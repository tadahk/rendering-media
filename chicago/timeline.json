 "clips": [
  {
   "id": "fort",
   "t0": 50.0,
   "t1": 56.0,
   "dissolve": 0.8,
   "at": "fort",
   "prompt": "Illustrated architectural visualisation in soft graphite pencil on cream paper. On an empty grassy bank where a river flows into a lake, a small 1803 frontier fort is built: first a faint pencil outline of the square stockade on the ground, then timber posts rise, two square blockhouses and long low barracks frame up, and the drawing fills in with fine pencil detail. Locked-off camera: the framing, horizon, river, lake and trees stay exactly where they are for the whole shot, and the water keeps its pale blue colour. No cuts, no zoom, no change of view or background; the fort builds up in place. Not photorealistic. No people, no animals, no text, no faces."
  }
 ],
 "narration": [
  {
   "id": "n1",
   "t": 0.8,
   "text": "Almost everything you're looking at was built after one night in October 1871."
  },
  {
   "id": "n1b",
   "t": 7.8,
   "text": "Let's go back."
  },
  {
   "id": "n2",
   "t": 40.2,
   "text": "This is the story of the city that burned, and what it did next."
  },
  {
   "id": "n3",
   "t": 50.6,
   "text": "In 1803 the United States Army built a small fort where a river met a lake."
  },
  {
   "id": "n4",
   "t": 65.6,
   "text": "In 1830 a surveyor drew a grid across the swamp."
  },
  {
   "id": "n5b",
   "t": 74.0,
   "text": "In 1833 about three hundred and fifty people incorporated the Town of Chicago. Four years later, it became a city."
  },
  {
   "id": "n6a",
   "t": 88.6,
   "text": "In 1848 a canal joined the lake to the Mississippi,"
  },
  {
   "id": "n6b",
   "t": 94.8,
   "text": "and the first train ran west."
  },
  {
   "id": "n6c",
   "t": 101.0,
   "text": "Chicago became the place where a continent's grain, timber and cattle changed hands."
  },
  {
   "id": "n7",
   "t": 116.5,
   "text": "By 1870, nearly three hundred thousand people. Most of their city was made of wood."
  },
  {
   "id": "n8",
   "t": 124.6,
   "text": "The summer of 1871 was dry."
  }
 ],
